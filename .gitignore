# Local build, toolchain, test data and release outputs
/.tmp/*
!/.tmp/.gitkeep
/dist/
/packages/ui/node_modules/
/packages/ui/dist/
/build-*/
/dist-*/
**/bin/
**/obj/
**/target/
**/TestResults/
**/coverage/
*.trx
*.coverage
*.coveragexml

# IDE and per-user state
.vs/
.idea/
*.csproj.user
*.suo
*.sln.docstates
*.userosscache
*.sln.ide
.DS_Store
Thumbs.db
Desktop.ini

# Local secrets (templates remain versioned)
.env
.env.*
!.env.example
!.env.sample
*.pfx
*.p12
*.snk

# Release backups and accidental expanded Windows cache paths
/reference-backups/
/%SystemDrive%/
__pycache__/
*.py[cod]
# Cargo.lock, npm lockfiles, schemas and fixtures are source inputs.
