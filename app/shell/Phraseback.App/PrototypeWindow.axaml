<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Phraseback.App.PrototypeWindow" Title="Phraseback · Interaction previews"
        Width="960" Height="680" MinWidth="760" MinHeight="580" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,76" Margin="26">
    <Grid ColumnDefinitions="*,260" Margin="0,0,0,22">
      <StackPanel Spacing="8"><TextBlock Text="Design previews" Classes="section" /><TextBlock Text="Interaction previews" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="Synthetic states. No capture, downloads or generation." Classes="muted" FontSize="12" /></StackPanel>
      <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Preview state" Classes="muted" FontSize="11" /><ComboBox ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Preview state" /></StackPanel>
    </Grid>
    <Border Grid.Row="1" Classes="panel" Padding="22">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Spacing="10" Margin="0,0,0,18"><TextBlock Text="{Binding Heading}" FontSize="21" TextWrapping="Wrap" /><TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" LineHeight="20" /></StackPanel>
        <Grid Grid.Row="1">
          <Grid IsVisible="{Binding ShowEvidence}" ColumnDefinitions="*,220">
            <Border Background="{DynamicResource PreviewBrush}" CornerRadius="8" Padding="8" Margin="0,0,18,0"><Image Source="{Binding Image}" Stretch="Uniform" AutomationProperties.Name="Synthetic evidence preview" /></Border>
            <StackPanel Grid.Column="1" Spacing="12">
              <TextBlock Text="Selected moment" Classes="section" />
              <TextBlock Text="Choose an appearance" FontSize="17" TextWrapping="Wrap" />
              <TextBlock Text="Select the appearance card. The selected option becomes highlighted." TextWrapping="Wrap" Classes="muted" LineHeight="20" />
              <ProgressBar Minimum="0" Maximum="5" Value="2" IsVisible="{Binding ShowProgress}" Height="5" />
              <TextBox Text="A manual draft stays here, even if saving fails." AcceptsReturn="True" TextWrapping="Wrap" IsVisible="{Binding IsError}" AutomationProperties.Name="Synthetic unsaved draft" />
              <ListBox ItemsSource="{Binding Alternatives}" SelectedItem="{Binding Alternative, Mode=TwoWay}" IsVisible="{Binding ShowAlternatives}" MaxHeight="185" Background="Transparent" AutomationProperties.Name="Grouped alternatives">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><Image Source="{Binding Image}" Width="54" Height="38" Stretch="Uniform" /><TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Grid>
          <StackPanel IsVisible="{Binding ShowEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
            <TextBlock Text="No recordings yet" FontSize="27" HorizontalAlignment="Center" />
            <TextBlock Text="A quiet place for your next walkthrough." Classes="muted" />
          </StackPanel>
          <ScrollViewer IsVisible="{Binding ShowSetup}">
            <StackPanel Spacing="12">
              <TextBlock Text="Recording name" Classes="muted" /><TextBox Text="A calmer workspace" AutomationProperties.Name="Synthetic recording name" />
              <TextBlock Text="Source" Classes="muted" /><ComboBox ItemsSource="{Binding Sources}" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Synthetic capture source" />
              <TextBlock Text="Region in physical pixels · design fields only" Classes="muted" />
              <Grid ColumnDefinitions="*,*,*,*">
                <NumericUpDown Value="0" Minimum="-10000" Maximum="10000" AutomationProperties.Name="Region X" Margin="0,0,8,0" />
                <NumericUpDown Grid.Column="1" Value="0" Minimum="-10000" Maximum="10000" AutomationProperties.Name="Region Y" Margin="0,0,8,0" />
                <NumericUpDown Grid.Column="2" Value="1920" Minimum="1" Maximum="2560" AutomationProperties.Name="Region width" Margin="0,0,8,0" />
                <NumericUpDown Grid.Column="3" Value="1080" Minimum="1" Maximum="1600" AutomationProperties.Name="Region height" />
              </Grid>
              <TextBlock Text="8 FPS target · one display or region · no audio" Classes="muted" />
              <TextBlock Text="{Binding SelectionNote}" TextWrapping="Wrap" Foreground="{DynamicResource TideBrush}" />
            </StackPanel>
          </ScrollViewer>
          <StackPanel IsVisible="{Binding ShowSettings}" Spacing="14">
            <TextBlock Text="Local model" FontSize="17" /><ComboBox ItemsSource="{Binding Presets}" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Synthetic model preset" />
            <TextBlock Text="GPU failure will not silently switch to CPU. Existing assets must pass verification before reuse." TextWrapping="Wrap" Classes="muted" />
            <Separator Margin="0,6" />
            <TextBlock Text="Storage and privacy" FontSize="17" />
            <TextBlock Text="This interaction preview does not change recordings or settings." TextWrapping="Wrap" Classes="muted" />
            <TextBlock Text="No model downloads or preference writes are available in this design preview." TextWrapping="Wrap" Foreground="{DynamicResource TideBrush}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
      <TextBlock Text="{Binding Activity}" TextWrapping="Wrap" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Grid.Column="1" Content="{Binding ActionLabel}" IsVisible="{Binding ShowAction}" Click="ActionClick" VerticalAlignment="Center" Classes="accent" Margin="0,0,10,0" />
      <Button Grid.Column="2" Content="Back to workspace" Click="BackClick" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
