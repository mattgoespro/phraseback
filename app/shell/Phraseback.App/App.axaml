<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Phraseback.App.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBrush" Color="#F6FAFB" />
          <SolidColorBrush x:Key="LibraryBrush" Color="#EAF2F4" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PreviewBrush" Color="#E2EAED" />
          <SolidColorBrush x:Key="InkBrush" Color="#19313A" />
          <SolidColorBrush x:Key="MutedBrush" Color="#506B74" />
          <SolidColorBrush x:Key="TideBrush" Color="#086F7C" />
          <SolidColorBrush x:Key="TideHoverBrush" Color="#075C68" />
          <SolidColorBrush x:Key="TideSubtleBrush" Color="#D9EEF1" />
          <SolidColorBrush x:Key="DividerBrush" Color="#CADCE1" />
          <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuHoverBrush" Color="#E2E5E8" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#9D301C" />
          <SolidColorBrush x:Key="RecordBrush" Color="#B74422" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CanvasBrush" Color="#181818" />
          <SolidColorBrush x:Key="LibraryBrush" Color="#2B2B2E" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#252527" />
          <SolidColorBrush x:Key="PreviewBrush" Color="#111113" />
          <SolidColorBrush x:Key="InkBrush" Color="#F0F0F2" />
          <SolidColorBrush x:Key="MutedBrush" Color="#A8A8AE" />
          <SolidColorBrush x:Key="TideBrush" Color="#8FB1D9" />
          <SolidColorBrush x:Key="TideHoverBrush" Color="#A5C2E4" />
          <SolidColorBrush x:Key="TideSubtleBrush" Color="#303237" />
          <SolidColorBrush x:Key="DividerBrush" Color="#414146" />
          <SolidColorBrush x:Key="FieldBrush" Color="#303033" />
          <SolidColorBrush x:Key="MenuHoverBrush" Color="#3B3B3F" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#D97967" />
          <SolidColorBrush x:Key="RecordBrush" Color="#D65B4B" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#151A22" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#086F7C" />
        <ColorPaletteResources x:Key="Dark" Accent="#8FB1D9" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
    <Style Selector="TextBlock.field-label"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.timecode"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="7" /><Setter Property="Padding" Value="10,5" /><Setter Property="MinHeight" Value="30" /><Setter Property="Background" Value="{DynamicResource FieldBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="Button.subtle"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.menu-option"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
    <Style Selector="Button.menu-option:pointerover"><Setter Property="Background" Value="{DynamicResource MenuHoverBrush}" /></Style>
    <Style Selector="Button.accent"><Setter Property="Background" Value="{DynamicResource TideBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Style>
    <Style Selector="Button.accent:pointerover"><Setter Property="Background" Value="{DynamicResource TideHoverBrush}" /></Style>
    <Style Selector="Button.recording"><Setter Property="Background" Value="{DynamicResource RecordBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Style>
    <Style Selector="Button.ghost"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="7" /><Setter Property="Background" Value="{DynamicResource FieldBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="CornerRadius" Value="7" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Border.menu-surface"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="CornerRadius" Value="7" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBox.recording-picker ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource MenuHoverBrush}" /></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource TideSubtleBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
  </Application.Styles>
</Application>
