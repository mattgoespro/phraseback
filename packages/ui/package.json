{
  "name": "phraseback-electron",
  "version": "0.2.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "check": "node scripts/generate-contracts.mjs --check && tsc --noEmit -p tsconfig.json",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "test": "vitest run",
    "build": "vite build && esbuild src/main/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/main/main.js && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/preload/preload.js",
    "dev": "npm run build && electron ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "ajv": "^8.20.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.5.1",
    "esbuild": "^0.25.0",
    "json-schema-to-typescript": "^16.0.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
